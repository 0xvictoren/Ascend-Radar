PORT=8787
PUBLIC_URL=http://localhost:8787

# Data source: "sim" (simulated launches) or "elysium" (live Ascend on Elysium testnet)
SOURCE=sim
SIM_SEED=7
SIM_SPEED=40

# Elysium (defaults are the public testnet endpoints)
DB_PATH=data/radar.db
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_EXPLORER_API=https://testnet-api.elysium.kinetiq.xyz/api/v2
# Comma-separated AscendLaunchpad addresses (defaults to the known testnet deployments)
ASCEND_LAUNCHPADS=
# USD price for non-USD quotes, e.g. 0xa7cd...:180 (USD-named quotes are valued at 1)
QUOTE_USD=
# A funder with this many transactions is a hub (faucet, bridge, exchange) and never links wallets
HUB_TX_THRESHOLD=2000
# Extra hubs, comma-separated
HUB_ADDRESSES=

# Buy links: Ascend token page; add a referral query once Ascend publishes the format
ASCEND_APP_URL=https://app.ascendlaunch.xyz
ASCEND_BUY_QUERY=

# Pro: "on" gates copy-alerts and /api/v1 behind a subscription key or an x402 payment
PRO_MODE=off
# Subscriptions paid in USDC on Elysium, verified from the payment tx
PRO_TREASURY=
PRO_USDC=0x4b4fb5c5794f0c821464956374cc5872d5f0f140
PRO_PRICE_USDC=25
PRO_DAYS=30
# x402 pay-per-call for /api/v1/risk/:token (network must be supported by the facilitator)
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=base-sepolia
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_PRICE_ATOMIC=1000

# Optional alert sinks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
